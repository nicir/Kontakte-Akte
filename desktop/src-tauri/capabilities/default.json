{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. No shell, no filesystem, no HTTP from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
